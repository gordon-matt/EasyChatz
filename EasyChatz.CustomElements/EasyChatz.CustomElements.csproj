<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<Description>EasyChatz as a standard custom element (&lt;ec-chat&gt;) for React, Vue, Angular or plain HTML pages.</Description>
		<WasmFingerprintAssets>false</WasmFingerprintAssets>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
		<PackageReference Include="Microsoft.AspNetCore.Components.CustomElements" Version="10.0.13" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\EasyChatz.Components\EasyChatz.Components.csproj" />
	</ItemGroup>

</Project>
