<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Description>Services behind EasyChatz: rooms, direct messages and unread notifications.</Description>
		<PackageTags>chat;messaging;chatrooms;direct-messages;notifications;easychatz</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\EasyChatz.Data\EasyChatz.Data.csproj" />
	</ItemGroup>

</Project>
