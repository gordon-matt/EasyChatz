@namespace EasyChatz.Components.Shared

<svg class="ec-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    @switch (Name)
    {
        case "hash":
            <path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18" />
            break;
        case "message":
            <path d="M21 12a8.5 8.5 0 0 1-8.5 8.5c-1.3 0-2.5-.3-3.6-.8L3 21l1.4-4.6A8.5 8.5 0 1 1 21 12Z" />
            break;
        case "users":
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="3" />
            <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a3 3 0 0 1 0 5.74" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "send":
            <path d="m22 2-7 20-4-9-9-4Z" />
            <path d="M22 2 11 13" />
            break;
        case "trash":
            <path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14" />
            break;
        case "pencil":
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
            break;
        case "x":
            <path d="M18 6 6 18M6 6l12 12" />
            break;
        case "megaphone":
            <path d="m3 11 13-6v14L3 13v-2Z" />
            <path d="M6 14.5V19a2 2 0 0 0 2 2h1" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";
}
